SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=postgresql+asyncpg://cityai:cityai123@localhost:5433/cityai_db
REDIS_URL=redis://localhost:6379

# Video sources
DEFAULT_CAMERA_SOURCE=0
RTSP_URL=rtsp://your-ip-camera/stream

# AI Models
YOLO_MODEL_PATH=../ai_models/yolov8n.pt
YOLO_CONF_THRESHOLD=0.45
YOLO_IMG_SIZE=640

# Evidence storage
EVIDENCE_DIR=../data/evidence

# Mapbox (get free token from mapbox.com)
MAPBOX_TOKEN=pk.your_mapbox_token_here

# Demo mode (uses pre-recorded videos instead of live cameras)
DEMO_MODE=true
